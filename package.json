{
  "name": "root",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "nohoist": [
      "**/react",
      "**/react-**"
    ]
  },
  "scripts": {
    "postinstall": "husky install",
    "version": "yarn run bootstrap && yarn build",
    "update": "lerna updated",
    "publish:npm": "lerna publish --force-publish --conventional-commits",
    "bootstrap": "lerna bootstrap",
    "prebuild": "yarn clean",
    "build": "lerna run build --stream",
    "clean": "lerna run clean --stream --parallel",
    "test": "yarn test:browser && yarn test:node",
    "test:node": "vitest run --config=vitest.config.ts  --coverage",
    "test:browser": "vitest run --config=vitest.browser.config.ts  --coverage",
    "make-badges": "istanbul-badges-readme",
    "example": "yarn workspace @portkey/example run",
    "coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@babel/core": "^7.20.12",
    "@babel/plugin-proposal-decorators": "^7.20.13",
    "@babel/preset-env": "^7.20.2",
    "@babel/preset-typescript": "^7.18.6",
    "@commitlint/cli": "^17.1.2",
    "@commitlint/config-conventional": "^17.1.0",
    "@next/bundle-analyzer": "^12.2.4",
    "@peculiar/webcrypto": "^1.5.0",
    "@tsconfig/recommended": "^1.0.1",
    "@types/elliptic": "^6.4.14",
    "@typescript-eslint/eslint-plugin": "^5.19.0",
    "@typescript-eslint/parser": "^5.19.0",
    "@vitest/coverage-v8": "^1.0.0",
    "browser-resolve": "^2.0.0",
    "esbuild": "^0.17.7",
    "eslint": "^7.32.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-prettier": "^3.1.3",
    "eslint-plugin-tsdoc": "^0.2.17 ",
    "events": "^3.3.0",
    "fix-esm-import-path": "^1.4.0",
    "husky": "^8.0.1",
    "isomorphic-fetch": "^3.0.0",
    "istanbul-badges-readme": "^1.8.5",
    "jsdom": "^23.0.0",
    "lerna": "^6.5.1",
    "lint-staged": ">=13",
    "node-fetch": "^3.3.0",
    "postcss": "^8.4.21",
    "postcss-url": "^10.1.3",
    "prettier": "^2.6.2",
    "process": "^0.11.10",
    "stream-browserify": "^3.0.0",
    "ts-node": "^10.9.1",
    "typescript": "^4.9.4",
    "vitest": "^1.0.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": "eslint --cache --fix"
  },
  "husky": {
    "hooks": {
      "pre-commit": "yarn run test && istanbul-badges-readme && git add 'README.md'"
    }
  },
  "version": "0.0.0",
  "dependencies": {
    "@portkey/request": "^2.21.0-alpha.2"
  }
}
